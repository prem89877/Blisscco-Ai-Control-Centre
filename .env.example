# Public (safe in browser)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# Server-only. Set ONLY in Vercel env vars. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Agent 1 (Infrastructure & Deployment). Server-only. Vercel env vars / Termux .env.agent1 ----
AGENT1_GEMINI_API_KEY=            # dedicated Gemini key for Agent 1 only
AGENT1_GEMINI_MODEL=gemini-3.5-flash
AGENT1_VERCEL_TOKEN=              # Vercel access token (scope: your team)
AGENT1_VERCEL_TEAM_ID=            # optional, if projects live in a team
AGENT1_VERCEL_PROJECTS=           # optional comma list of project names to monitor
AGENT1_SUPABASE_ACCESS_TOKEN=     # Supabase PAT, scope: Database READ on Denim Hub BSL only
AGENT1_GITHUB_TOKEN=              # fine-grained, read-only (Contents, Actions, Metadata)
AGENT1_GITHUB_REPOS=              # e.g. youruser/blisscco-ai-control-center
AGENT1_REQUIRED_ENV=              # optional JSON: {"project-name":["KEY1","KEY2"]}

# ---- Agent 2 (Development & GitHub). Server-only. Vercel env vars / Termux .env.agent2 ----
AGENT2_GEMINI_API_KEY=            # dedicated key from its OWN Google AI Studio project (not Agent 1's)
AGENT2_GEMINI_MODEL=gemini-3.5-flash
AGENT2_GITHUB_TOKEN=              # fine-grained, only the repos below: Contents RW, Pull requests RW, Actions READ+WRITE (needed to start workflows), Deployments read, Metadata
AGENT2_GITHUB_REPOS=              # allow-list, e.g. youruser/blisscco-ai-control-center (Agent 2 touches nothing else)
AGENT2_REVIEW_MAX_INPUT_CHARS=    # optional, Gemini review input cap for ZIP/diff summaries (default 14000, clamped 2000-60000)
AGENT2_REVIEW_MAX_OUTPUT_TOKENS=  # optional, Gemini review output cap (default 1200, clamped 200-4000)
ORCH_ZIP_PROTECTED_EXTRA=         # optional, comma-separated extra paths/prefixes an uploaded ZIP may never touch (built in: orchestrator/ agent1/ agent2/ api/ .github/ supabase/)
AGENT2_PROTECTED_BRANCHES=        # optional, default main,master,production,prod (never written directly)
AGENT2_WORKDIR=                   # Termux only: path of the repo to work in (default: current folder)

# ---- Agent 3 (QA, Testing & Security). Server-only. Vercel env vars / Termux .env.agent3 ----
AGENT3_GEMINI_API_KEY=            # dedicated key from its OWN Google AI Studio project (not Agent 1/2's)
AGENT3_GEMINI_MODEL=gemini-3.5-flash
AGENT3_TARGETS=                   # allow-list of https sites to test, comma list, e.g. https://blisscco.com,https://admin.blisscco.com (nothing else is ever contacted)
AGENT3_WEB_PATHS=/                # pages for smoke test, e.g. /,/login,/advertiser,/publisher
AGENT3_PROTECTED_PATHS=           # pages that must NOT open without login, e.g. /admin,/advertiser/dashboard,/publisher/dashboard
AGENT3_API_ENDPOINTS=             # JSON, e.g. [{"name":"serve","path":"/api/serve","method":"GET","auth":"key","billing_risk":true},{"name":"stats","path":"/api/stats","method":"GET","auth":"key"}]  (auth: none|key|user)
AGENT3_TEST_API_KEY=              # optional: a TEST publisher key. Used ONLY on non-billing endpoints. Never sent to billing-risk paths.
AGENT3_NONBILLABLE_PATHS=         # optional: billing-looking paths YOU confirm are safe with a valid test key (leave empty if unsure)
AGENT3_SUPABASE_ACCESS_TOKEN=     # Supabase PAT, Database READ only (for RLS / schema / billing integrity checks)
AGENT3_GITHUB_TOKEN=              # fine-grained, READ-ONLY (Contents, Metadata) for secret + dependency scan
AGENT3_GITHUB_REPOS=              # e.g. youruser/blisscco-ai-control-center,youruser/blisscco-ads

# ---- Phase 3 Part 3 (all optional; safe defaults)
ORCH_VISIBILITY_SECONDS=          # how long finished/failed tasks stay in the dashboard list (default and minimum 300 = 5 min; display only, never deletes records)
ORCH_STALE_MS=                    # a transient stage without progress for this long (min 60000, default 300000) is treated as interrupted
ORCH_RETRY_MAX_ATTEMPTS=          # read-only retries (1-6, default 3)
ORCH_RETRY_BASE_MS=               # first backoff wait, doubles each attempt (0-10000, default 250)
ORCH_RETRY_MAX_TOTAL_MS=          # hard cap on total retry time (0-60000, default 15000)

# Agent 2 professional developer limits (all optional; values are clamped to safe ranges)
# AGENT2_DEV_MAX_CONTEXT_FILES=25   # files read per request (1-80)
# AGENT2_DEV_MAX_CONTEXT_BYTES=120000
# AGENT2_DEV_MAX_FILES=40           # files per proposal (1-120); bigger plans are returned for splitting, never truncated
# AGENT2_DEV_BATCH_SIZE=8           # files generated per model call (1-20)
# AGENT2_DEV_MAX_FIX_ROUNDS=2       # self-fix rounds after a failed check (0-5)
# AGENT2_DEV_HISTORY_TURNS=10       # chat turns sent as context (1-30)
